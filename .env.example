NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public origin (no trailing slash). Used for trusted auth redirects.
# Local: http://localhost:3000
# Prod:  https://vairo.pl  (or https://vairo-network.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CTA po domknięciu MVP Stage (§1C). Mailto albo zewnętrzny formularz — bez płatności.
# NEXT_PUBLIC_MVP_CONTACT_URL=mailto:hello@vairo.pl?subject=Dalsza%20wspolpraca

# Supabase → Authentication → URL Configuration
# Site URL: same as NEXT_PUBLIC_SITE_URL
# Redirect URLs:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/callback*
#   https://YOUR_PROD_DOMAIN/auth/callback
#   https://YOUR_PROD_DOMAIN/auth/callback*

# --- Pomoc i opinie (migracja 043) -------------------------------------------
# Zgłoszenia z aplikacji idą MAILEM do skrzynki zespołu, z Reply-To = autor.
# Odpowiada się zwykłym „Odpowiedz” w poczcie (albo w helpdesku podpiętym pod
# tę skrzynkę). Bez tych zmiennych zgłoszenie i tak zapisuje się w bazie
# (delivery_status = failed) — widać je w supabase/SUPPORT_zgloszenia.sql.
#
# Resend: resend.com → API Keys. Domena nadawcy musi być zweryfikowana
# (DNS: SPF + DKIM), inaczej maile wpadną do spamu albo nie wyjdą wcale.
# Tylko serwer — NIGDY z prefiksem NEXT_PUBLIC_.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Vairo <no-reply@vairo.pl>
# Dokąd trafiają zgłoszenia (kilka adresów po przecinku):
# SUPPORT_INBOX_EMAIL=support@vairo.pl
# Adres pokazywany ludziom (strona Pomocy, ekran błędu). Bez niego nie
# pokazujemy żadnego adresu.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@vairo.pl
